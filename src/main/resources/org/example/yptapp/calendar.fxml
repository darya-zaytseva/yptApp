<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.CalendarController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Шапка -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="monthLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="Месяц" />
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="groupFilterCombo" prefWidth="200" promptText="Все группы" style="-fx-background-radius: 8;" />
        <Button onAction="#prevWeek" style="-fx-background-color: white; -fx-text-fill: #00838f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" text="←" />
        <Button onAction="#nextWeek" style="-fx-background-color: white; -fx-text-fill: #00838f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" text="→" />
        <Button onAction="#back" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20;" text="Назад" />
    </HBox>

    <!-- Дни недели -->
    <HBox fx:id="weekHeader" spacing="10" alignment="CENTER" />

    <!-- Сетка календаря -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <GridPane fx:id="calendarGrid" hgap="10" vgap="5">
            <columnConstraints>
                <ColumnConstraints prefWidth="50" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
                <ColumnConstraints prefWidth="140" />
            </columnConstraints>
        </GridPane>
    </ScrollPane>
</VBox>