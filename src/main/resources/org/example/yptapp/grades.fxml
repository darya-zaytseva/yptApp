<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.GradesController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="Журнал оценок" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#back" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="← Назад" />
    </HBox>

    <TableView fx:id="table" prefHeight="260" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e0e0e0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
        <columns>
            <TableColumn fx:id="colStudent" prefWidth="210" text="Студент" />
            <TableColumn fx:id="colSubject" prefWidth="190" text="Предмет" />
            <TableColumn fx:id="colGrade" prefWidth="90" text="Оценка" />
            <TableColumn fx:id="colType" prefWidth="110" text="Тип" />
            <TableColumn fx:id="colDate" prefWidth="110" text="Дата" />
        </columns>
    </TableView>

    <HBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Студент" />
            <ComboBox fx:id="studentCombo" prefWidth="210" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;" />
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Предмет" />
            <ComboBox fx:id="subjectCombo" prefWidth="210" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;" />
        </VBox>
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Оценка" />
            <TextField fx:id="gradeField" prefWidth="90" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" />
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Тип" />
            <ComboBox fx:id="typeCombo" prefWidth="120" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;" />
        </VBox>
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Дата" />
            <DatePicker fx:id="datePicker" prefWidth="140" style="-fx-background-radius: 8;" />
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Комментарий" />
            <TextField fx:id="commentField" prefWidth="210" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" />
        </VBox>
    </HBox>

    <HBox spacing="12">
        <Button onAction="#add" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="➕ Добавить" />
        <Button onAction="#update" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="✏ Обновить" />
        <Button onAction="#delete" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="🗑 Удалить" />
    </HBox>
</VBox>