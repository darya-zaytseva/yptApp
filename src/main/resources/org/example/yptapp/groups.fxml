<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.GroupsController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Шапка -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="👥 Управление группами" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#back" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" text="← Назад" />
    </HBox>

    <!-- Таблица -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" prefWidth="180" text="Название" />
            <TableColumn fx:id="colSpec" prefWidth="300" text="Специальность" />
            <TableColumn fx:id="colYear" prefWidth="100" text="Курс" />
        </columns>
    </TableView>

    <!-- Форма добавления -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #00838f;" text="Добавить / Редактировать" />

        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Название группы" />
                <TextField fx:id="nameField" prefWidth="180" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 8 12;" />
            </VBox>
            <VBox spacing="6">
                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Специальность" />
                <TextField fx:id="specField" prefWidth="260" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 8 12;" />
            </VBox>
            <VBox spacing="6">
                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Курс" />
                <Spinner fx:id="yearSpinner" prefWidth="80" style="-fx-background-radius: 8;" />
            </VBox>
            <VBox spacing="6">
                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Приватность"/>
                <ComboBox fx:id="privacyCombo" prefWidth="120" style="-fx-background-radius: 8;"/>
            </VBox>
            <VBox spacing="6">
                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Макс. участников"/>
                <Spinner fx:id="maxMembersSpinner" prefWidth="100" style="-fx-background-radius: 8;"/>
            </VBox>
        </HBox>
        <VBox spacing="6">
            <Label style="-fx-text-fill: #546e7a; -fx-font-size: 12px;" text="Описание"/>
            <TextArea fx:id="descArea" prefWidth="400" prefRowCount="2" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;"/>
        </VBox>
        <HBox spacing="10">
            <Button onAction="#add" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 25; -fx-cursor: hand;" text="➕ Добавить" />
            <Button onAction="#update" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 25; -fx-cursor: hand;" text="✏ Обновить" />
            <Button onAction="#delete" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 25; -fx-cursor: hand;" text="🗑 Удалить" />
        </HBox>
    </VBox>
</VBox>