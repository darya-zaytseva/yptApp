<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.MainController">

<top>
    <VBox spacing="0">
        <!-- Верхняя полоска -->
        <HBox alignment="CENTER" spacing="5" style="-fx-background-color: linear-gradient(to right, #1a237e, #00838f); -fx-padding: 15;">
            <Button onAction="#openGroups" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="ГРУППЫ" />
            <Button onAction="#openStudents" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="СТУДЕНТЫ" />
            <Button onAction="#openSubjects" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="ПРЕДМЕТЫ" />
            <Button onAction="#openSchedule" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="РАСПИСАНИЕ" />
            <Button onAction="#openCalendar" style="-fx-background-color: transparent; -fx-text-fill: #ffcc80; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="📅 КАЛЕНДАРЬ" />
            <Button onAction="#openGrades" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="ОЦЕНКИ" />
            <Button onAction="#openMaterials" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="📚 УЧЕБНИКИ" />
            <Button onAction="#openFriends" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="👥 ДРУЗЬЯ"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#logout" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand;" text="ВЫХОД" />
        </HBox>

        <!-- Приветствие -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 25;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #546e7a;" text="YPT — Система управления учебной группой" />
        </HBox>
    </VBox>
</top>

<center>
    <VBox alignment="CENTER" spacing="25" style="-fx-background-color: #f5f5f5;">
        <padding>
            <Insets bottom="40" left="40" right="40" top="30" />
        </padding>

        <!-- Карточки статистики -->
        <HBox spacing="20" alignment="CENTER">
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                <Label style="-fx-font-size: 36px;" text="👨‍🎓" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="3" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #78909c;" text="Студентов" />
            </VBox>
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                <Label style="-fx-font-size: 36px;" text="📖" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #00838f;" text="3" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #78909c;" text="Предметов" />
            </VBox>
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                <Label style="-fx-font-size: 36px;" text="📚" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ff7043;" text="2" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #78909c;" text="Группы" />
            </VBox>
        </HBox>

        <!-- Быстрые действия -->
        <HBox spacing="15" alignment="CENTER">
            <Button onAction="#openCalendar" style="-fx-background-color: linear-gradient(to right, #5c6bc0, #00838f); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 15 30; -fx-background-radius: 12; -fx-cursor: hand;" text="📅 Открыть календарь" />
            <Button onAction="#openMaterials" style="-fx-background-color: linear-gradient(to right, #ff7043, #ffa726); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 15 30; -fx-background-radius: 12; -fx-cursor: hand;" text="📚 Учебники" />
        </HBox>
    </VBox>
</center>
</BorderPane>