<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.ProfileController">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="👤 Редактирование профиля"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#back" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;" text="← Назад"/>
    </HBox>

    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
        <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="ФИО"/>
        <TextField fx:id="fullNameField" prefWidth="300" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;"/>

        <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Локация (город)"/>
        <TextField fx:id="locationField" prefWidth="300" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;"/>

        <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Уровень знаний"/>
        <ComboBox fx:id="levelCombo" prefWidth="200" style="-fx-background-radius: 8;"/>

        <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Интересы"/>
        <TextArea fx:id="interestsArea" prefRowCount="3" prefWidth="400" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;"/>

        <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Цели обучения"/>
        <TextArea fx:id="goalsArea" prefRowCount="3" prefWidth="400" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;"/>

        <Button onAction="#save" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30;" text="💾 Сохранить"/>
    </VBox>
</VBox>