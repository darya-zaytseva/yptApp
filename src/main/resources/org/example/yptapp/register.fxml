<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: linear-gradient(to bottom right, #1a237e, #00838f);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.RegisterController">
    <padding><Insets bottom="40" left="50" right="50" top="40"/></padding>

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Регистрация в YPT"/>
    <Label style="-fx-font-size: 14px; -fx-text-fill: #80deea;" text="Создайте новый аккаунт"/>

    <Pane prefHeight="10"/>

    <TextField fx:id="usernameField" maxWidth="300" promptText="Логин *" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 12;"/>
    <PasswordField fx:id="passwordField" maxWidth="300" promptText="Пароль * (мин. 6 символов)" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 12;"/>
    <PasswordField fx:id="confirmPasswordField" maxWidth="300" promptText="Подтвердите пароль *" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 12;"/>
    <TextField fx:id="fullNameField" maxWidth="300" promptText="ФИО *" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 12;"/>

    <ComboBox fx:id="roleCombo" maxWidth="300" style="-fx-background-radius: 8;"/>

    <Label style="-fx-text-fill: #80cbc4; -fx-font-size: 12px;" text="Для студентов (опционально):"/>
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="firstNameField" prefWidth="145" promptText="Имя" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 10;"/>
        <TextField fx:id="lastNameField" prefWidth="145" promptText="Фамилия" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 10;"/>
    </HBox>
    <TextField fx:id="middleNameField" maxWidth="300" promptText="Отчество" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 12;"/>
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="phoneField" prefWidth="145" promptText="Телефон" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 10;"/>
        <TextField fx:id="emailField" prefWidth="145" promptText="Email" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: #b2ebf2; -fx-background-radius: 8; -fx-padding: 10;"/>
    </HBox>

    <Button maxWidth="300" onAction="#handleRegister" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" text="ЗАРЕГИСТРИРОВАТЬСЯ"/>

    <Button onAction="#backToLogin" style="-fx-background-color: transparent; -fx-text-fill: #80deea; -fx-cursor: hand;" text="Уже есть аккаунт? Войти"/>
</VBox>