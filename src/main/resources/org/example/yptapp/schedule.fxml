<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.yptapp.controller.ScheduleController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="Расписание занятий" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#back" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;" text="← Назад" />
    </HBox>

    <TableView fx:id="table" prefHeight="260" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e0e0e0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
        <columns>
            <TableColumn fx:id="colGroup" prefWidth="130" text="Группа" />
            <TableColumn fx:id="colSubject" prefWidth="220" text="Предмет" />
            <TableColumn fx:id="colDay" prefWidth="90" text="День" />
            <TableColumn fx:id="colPair" prefWidth="90" text="Пара" />
            <TableColumn fx:id="colRoom" prefWidth="110" text="Аудитория" />
        </columns>
    </TableView>

    <HBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Группа" />
            <ComboBox fx:id="groupCombo" prefWidth="160" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;" />
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Предмет" />
            <ComboBox fx:id="subjectCombo" prefWidth="220" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;" />
        </VBox>
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="День (1-7)" />
            <Spinner fx:id="daySpinner" prefWidth="90" style="-fx-background-radius: 8;" />
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Пара (1-8)" />
            <Spinner fx:id="pairSpinner" prefWidth="90" style="-fx-background-radius: 8;" />
        </VBox>
        <VBox spacing="6">
            <Label style="-fx-text-fill: #00838f; -fx-font-weight: bold; -fx-font-size: 13px;" text="Аудитория" />
            <TextField fx:id="roomField" prefWidth="110" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" />
        </VBox>
    </HBox>

    <HBox spacing="12">
        <Button onAction="#add" style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="➕ Добавить" />
        <Button onAction="#update" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="✏ Обновить" />
        <Button onAction="#delete" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 13px; -fx-cursor: hand;" text="🗑 Удалить" />
    </HBox>
</VBox>